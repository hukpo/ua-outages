{
  "name": "ua-outages",
  "version": "0.5.0",
  "description": "TypeScript SDK for Ukrainian power outage schedules: find your outage group by address and get schedules straight from the grid operators.",
  "keywords": [
    "ukraine",
    "power-outage",
    "blackout",
    "electricity",
    "schedule",
    "yasno",
    "dtek",
    "oblenergo",
    "графік відключень",
    "ai",
    "claude",
    "openai"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "import": "./dist/adapters/anthropic.js"
    },
    "./openai": {
      "types": "./dist/adapters/openai.d.ts",
      "import": "./dist/adapters/openai.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "import": "./dist/adapters/ai-sdk.js"
    },
    "./tanstack-ai": {
      "types": "./dist/adapters/tanstack-ai.d.ts",
      "import": "./dist/adapters/tanstack-ai.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE=1 vitest run test/live",
    "health": "tsx scripts/health.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@anthropic-ai/sdk": "^1.10.0",
    "@tanstack/ai": "^1.5.0",
    "@types/node": "^22.10.0",
    "ai": "^7.0.176",
    "openai": "^7.59.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=1.10.0",
    "@tanstack/ai": "^1.5.0",
    "ai": "^7.0.0",
    "openai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@tanstack/ai": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hukpo/ua-outages.git"
  },
  "homepage": "https://github.com/hukpo/ua-outages#readme",
  "bugs": {
    "url": "https://github.com/hukpo/ua-outages/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
